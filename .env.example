# Copy this file to .env and fill in your own values. Never commit the real .env file.

# --- LLM provider: OpenAI ---
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=paste-your-openai-api-key-here
OPENAI_MODEL=gpt-5.6-luna

# --- Embeddings ---
# Local, free, no API key needed (runs via sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=5
RETRIEVAL_CANDIDATE_K=8
# Chroma distance threshold; lower is more similar. Calibrate with your data.
MAX_DISTANCE=1.2

# --- Storage ---
VECTOR_DB_DIR=data/chroma_db
UPLOAD_DIR=data/uploads
CHROMA_ANONYMIZED_TELEMETRY=false

# --- Agent controls ---
MAX_REASONING_RETRIES=2

# --- API server ---
API_PORT=8080
