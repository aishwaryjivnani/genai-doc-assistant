# Copy this file to .env and fill in your own values. Never commit the real .env file.

# --- LLM provider: Google Gemini (free tier) ---
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-key-here
# Google's free-tier line-up changes periodically — check https://ai.google.dev/gemini-api/docs/pricing
# for the current free model before you rely on this. gemini-2.5-flash is free-tier as of Aug 2026.
GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings ---
# Local, free, no API key needed (runs via sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=4
MIN_RELEVANCE_SCORE=0.25

# --- Storage ---
VECTOR_DB_DIR=data/chroma_db
UPLOAD_DIR=data/uploads

# --- Agent controls ---
MAX_REASONING_RETRIES=2

# --- API server ---
API_PORT=8080
